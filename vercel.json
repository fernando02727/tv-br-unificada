{
  "functions": {
    "api/index.js": {
      "includeFiles": "{sources.json,config.json,lib/**,data/**}",
      "maxDuration": 20
    },
    "api/logo.js": {
      "maxDuration": 10
    },
    "api/img.js": {
      "maxDuration": 10
    },
    "api/thumb.js": {
      "maxDuration": 20,
      "memory": 1024,
      "includeFiles": "node_modules/ffmpeg-static/ffmpeg"
    }
  },
  "rewrites": [
    {
      "source": "/thumb/(.*)",
      "destination": "/api/thumb"
    },
    {
      "source": "/img",
      "destination": "/api/img"
    },
    {
      "source": "/logo/(.*)",
      "destination": "/api/logo"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "data": false
    }
  },
  "regions": [
    "gru1"
  ]
}
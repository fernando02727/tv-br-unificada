{
  "functions": {
    "api/index.js": {
      "includeFiles": "{sources.json,config.json,lib/**,data/**}",
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "data": false
    }
  },
  "regions": [
    "gru1"
  ]
}